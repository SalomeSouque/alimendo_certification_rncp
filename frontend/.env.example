# URL de base du backend FastAPI (lue au build par Vite).
VITE_API_URL=http://localhost:8000

# Mode d'authentification.
#   false (ou absent) = vrai backend (POST /auth/login, /auth/register, GET /auth/me).
#   true              = auth simulée, sans backend (démo hors ligne uniquement).
VITE_AUTH_MOCK=false