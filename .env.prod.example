# Modèle du fichier .env du SERVEUR de production.
# Sur le serveur :  cp .env.prod.example .env && nano .env && chmod 600 .env
# Le vrai .env n'est JAMAIS versionné. Toutes les valeurs CHANGE_ME sont à remplacer.

# --- Déploiement (lu par docker-compose.prod.yml) ---------------------------
APP_DOMAIN=CHANGE_ME.example.fr
# Noms fournis par l'hébergeur (configuration Traefik).
TRAEFIK_NETWORK=CHANGE_ME
TRAEFIK_ENTRYPOINT=CHANGE_ME
TRAEFIK_CERTRESOLVER=CHANGE_ME
# Version des images déployée. Mise à jour par deploy/deploy.sh, ne pas éditer à la main.
IMAGE_TAG=develop

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=alimendo
# Générer : openssl rand -hex 24   (hexadécimal : aucun caractère qui casse l'URL de connexion)
# Fixé au PREMIER démarrage du volume : le changer ensuite ne fait rien.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=alimendo
# Ports sur la boucle locale du serveur (127.0.0.1). Vérifier qu'ils sont libres : ss -tlnp
POSTGRES_PORT=5433
CHROMADB_PORT=8001

# --- Application --------------------------------------------------------------
# Toute valeur autre que "local" désactive /docs.
ENVIRONMENT=prod
LOG_LEVEL=INFO
CORS_ORIGINS=https://CHANGE_ME.example.fr

POSTGRES_HOST=db
POSTGRES_INTERNAL_PORT=5432
SQL_ECHO=false
DB_POOL_SIZE=5

# --- Sécurité -----------------------------------------------------------------
# Générer : openssl rand -hex 32   (différente de la clé de dev)
JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# --- Chatbot (Mistral) --------------------------------------------------------
# Clé dédiée à la prod (console Mistral), avec plafond de dépense. Jamais la clé de dev.
MISTRAL_API_KEY=CHANGE_ME
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-2603
MISTRAL_REASONING_EFFORT=none
MISTRAL_TEMPERATURE=0.15
MISTRAL_MAX_TOKENS=800
MISTRAL_TIMEOUT_SECONDS=30

# --- ChromaDB et embeddings (identiques à rag/config.py) ----------------------
CHROMA_HOST=chromadb
CHROMA_INTERNAL_PORT=8000
CHROMA_COLLECTION=endo_corpus
CHROMA_DISTANCE_METRIC=cosine
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
RAG_TOP_K=5

# --- Ollama (VLM) : utile seulement si le profil "ai" est lancé ---------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_NUM_CTX=4096
VLM_IMAGE_MAX_PX=1024
VLM_CONFIDENCE_THRESHOLD=0.5

# --- Open Food Facts ----------------------------------------------------------
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Alimendo/0.1 (projet etudiant RNCP37827)
OFF_TIMEOUT_SECONDS=10
