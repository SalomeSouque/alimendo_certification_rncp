POSTGRES_USER=alimendo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=alimendo
# Depuis un conteneur (backend) : DATABASE_URL=postgresql://user:pass@db:5432/dbname
# En local (scripts, DBeaver) : localhost:${POSTGRES_PORT}
POSTGRES_PORT=5433
CHROMADB_PORT=8001
OLLAMA_PORT=11434
FRONTEND_PORT=3000
FASTAPI_PORT=8000

#Config chatbot 
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
# Snapshot daté figé 
MISTRAL_MODEL=mistral-small-2603
# "none" = mode réponse directe, sans trace de raisonnement.
MISTRAL_REASONING_EFFORT=none
MISTRAL_TEMPERATURE=0.15
MISTRAL_MAX_TOKENS=800
# Délai mac d'attente d'une réponse HTTP, en secondes.
MISTRAL_TIMEOUT_SECONDS=30


# Application 
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Base de données 
# Nom du service dans docker-compose. En local (pytest, scripts,
# DBeaver), mettre `localhost` et utiliser POSTGRES_PORT au lieu de 5432.
POSTGRES_HOST=db
POSTGRES_INTERNAL_PORT=5432
# Affiche le SQL généré dans les logs
SQL_ECHO=false
DB_POOL_SIZE=5

# Sécurité 
# Génère une valeur avec : openssl rand -hex 32
# Changer cette clé rends les jetons émis invalides.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# Garde-fou X-API-Key.
ALIMENDO_API_KEY=

# ChromaDB et embeddings
# Ces 3 valeurs doivent être identiques à celles de rag/config.py.
CHROMA_HOST=chromadb
CHROMA_INTERNAL_PORT=8000
CHROMA_COLLECTION=endo_corpus
CHROMA_DISTANCE_METRIC=cosine
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Nombre de chunks remontés par question.
RAG_TOP_K=5

#  Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_TIMEOUT_SECONDS=120
VLM_CONFIDENCE_THRESHOLD=0.5

#  Open Food Facts 
OFF_BASE_URL=https://world.openfoodfacts.org
# OFF exige un User-Agent identifiant l'application.
OFF_USER_AGENT=Alimendo/0.1 (projet etudiant RNCP37827)
OFF_TIMEOUT_SECONDS=10
